<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Create Event | EventHub</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <header class="navbar">
    <span class="brand">✦ EventHub</span>
    <div class="nav-links">
      <a href="/dashboard">Dashboard</a>
      <a href="/events">Events</a>
      <a href="/registrations">My Registrations</a>
      <form action="/auth/logout" method="post"><button class="logout" type="submit">Log out</button></form>
    </div>
  </header>

  <main class="page">
    <h1>Create Event</h1>
    <% if (error) { %><div class="error" role="alert"><%= error %></div><% } %>

    <form class="form-card" action="/events" method="post">
      <label>Event Code
        <input type="text" name="eventCode" required pattern="^[A-Za-z0-9-]{3,20}$" title="3-20 letters, numbers or hyphens" placeholder="EVT-2026-001">
      </label>
      <label>Title
        <input type="text" name="title" required maxlength="120">
      </label>
      <label>Description
        <textarea name="description" rows="3" maxlength="2000"></textarea>
      </label>
      <label>Category
        <select name="category" required>
          <option value="">Please select...</option>
          <% categories.forEach(function (cat) { %><option value="<%= cat %>"><%= cat %></option><% }); %>
        </select>
      </label>
      <label>Venue
        <input type="text" name="venue" required maxlength="120">
      </label>
      <label>Capacity
        <input type="number" name="capacity" required min="1">
      </label>
      <label>Start At
        <input type="datetime-local" name="startAt" required>
      </label>
      <label>End At (optional)
        <input type="datetime-local" name="endAt">
      </label>
      <label>Organizer (optional)
        <input type="text" name="organizer" maxlength="100">
      </label>
      <div class="actions">
        <button class="btn" type="submit">Create Event</button>
        <a href="/events" class="btn btn-secondary">Cancel</a>
      </div>
    </form>
  </main>
</body>
</html>
