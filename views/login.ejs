<!DOCTYPE html>
<html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Sign in | EventHub</title><link rel="stylesheet" href="/css/style.css"></head>
<body><main class="auth-wrap"><section class="auth-card"><div class="brand">✦ EventHub</div><p class="eyebrow">EVENT REGISTRATION SYSTEM</p><h1>Welcome back</h1><p class="muted">Sign in to manage and join events.</p>
<% if (error) { %><div class="error" role="alert"><%= error %></div><% } %>
<form action="/auth/login" method="post"><label>Email address<input name="email" type="email" autocomplete="email" placeholder="you@example.com" required></label><label>Password<input name="password" type="password" autocomplete="current-password" placeholder="Enter password" required></label><button type="submit">Sign in →</button></form><p class="footnote">New here? <a href="/auth/register">Create an account</a></p></section><aside class="hero"><span class="hero-pill">PLAN • DISCOVER • JOIN</span><h2>Bring people together through great events.</h2><p>One place to explore events, register, and stay organized.</p><div class="hero-shapes">✳ &nbsp; ◉ &nbsp; ✦</div></aside></main></body></html>
